# Copy to .env.local / your host's environment settings. Never commit real values.

# --- Web (Vite: exposed to the browser, baked in at BUILD time) ---
# Leave empty when web and API are served from the same origin (local dev proxy).
VITE_API_URL=
VITE_WS_URL=

# --- API (server-side only) ---
# Comma-separated browser origins allowed by CORS, e.g. https://saha.vercel.app
APP_URL=http://localhost:5173
PORT=4000

# Set both when the web app is on a different site than the API.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Local JSON (single instance, persistent disk required) or postgres.
DATA_ADAPTER=local
# LOCAL_DATA_FILE=./data/store.json
# DATABASE_URL=postgres://user:password@host:5432/saha
# PGSSLMODE=require
# PG_POOL_MAX=5

# --- Encrypted credential vault ---
# REQUIRED in production. Either 64 hex characters (32-byte key) or any long
# passphrase, which is SHA-256 hashed into a key. Never commit the real value.
# CREDENTIAL_MASTER_KEY=
# Current key version stored on each sealed record; increment after rotation.
# CREDENTIAL_KEY_VERSION=1
# Set only during re-sealing after a master-key change, then unset it.
# CREDENTIAL_MASTER_KEY_PREVIOUS=
